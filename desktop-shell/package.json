{
  "name": "sentinelai",
  "version": "1.0.0-beta.1",
  "description": "SentinelAI - Intelligent Desktop Assistant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:publish": "electron-builder --win --publish always",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:linux-deb": "electron-builder --linux deb --publish never",
    "dist:dir": "electron-builder --win --dir"
  },
  "keywords": [
    "ai",
    "assistant",
    "desktop",
    "automation"
  ],
  "author": {
    "name": "Sentinel Prime Inc.",
    "email": "support@sentinelprime.org"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lordsleezy/SentinelAI.git"
  },
  "build": {
    "appId": "org.sentinelprime.sentinelai",
    "productName": "SentinelAI",
    "copyright": "Copyright 2026 Sentinel Prime Inc.",
    "publish": {
      "provider": "github",
      "owner": "Lordsleezy",
      "repo": "SentinelAI"
    },
    "directories": {
      "output": "../installer_dist",
      "buildResources": "assets"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "../backend_dist/sentinel_backend",
        "to": "sentinel_backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../.env.example",
        "to": ".env.example"
      },
      {
        "from": "../memory",
        "to": "memory",
        "filter": [
          "**/.gitkeep"
        ]
      },
      {
        "from": "../config",
        "to": "config",
        "filter": [
          "**/.gitkeep"
        ]
      },
      {
        "from": "../capability_registry.json",
        "to": "capability_registry.json"
      },
      {
        "from": "../README.md",
        "to": "README.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "artifactName": "SentinelAISetup.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sentinel AI",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "uninstallDisplayName": "Sentinel AI",
      "guid": "8f3c2a1e-9b4d-4e6f-a1c2-5d7e9f0b3a4c",
      "include": "installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Sentinel Prime Inc. <support@sentinelprime.org>",
      "icon": "assets/icons",
      "category": "Utility",
      "artifactName": "SentinelAI.${ext}",
      "desktop": {
        "Name": "Sentinel AI",
        "Comment": "SentinelAI personal assistant",
        "StartupWMClass": "sentinelai",
        "Categories": "Utility;"
      },
      "synopsis": "SentinelAI desktop assistant",
      "description": "SentinelAI — local-first AI assistant by Sentinel Prime Inc."
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.3",
    "monaco-editor": "^0.55.1",
    "node-fetch": "^2.6.7",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-ai-orb": "^1.0.13",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "electron": "^23.0.0",
    "electron-builder": "^23.6.0"
  }
}
